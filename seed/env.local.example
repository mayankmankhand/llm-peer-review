# API keys for the LLM Peer Review toolkit. Copy this file to .env.local and fill in
# the keys you use. Never commit .env.local (the toolkit's .gitignore lines skip it).
# Quotes around values are optional - the parser handles both formats.
# No 'export' needed - this is a .env file, not a shell script.
#
# Where the toolkit looks for each variable, first value wins:
#   1. A real environment variable. It always wins and is never overwritten.
#   2. This project's own .env.local, found by searching from the folder the command
#      runs in up to the git root. Only the nearest file is read.
#   3. ~/.claude/plugins/.env.local, one file for keys shared by every project on
#      this machine. It fills only what the first two leave out.
# A blank value counts as not set, so a project .env.local copied from this example
# with its keys still empty does not hide the keys in the shared file.

# Required for /tk:ask-gpt (ChatGPT API calls)
OPENAI_API_KEY=

# Model version for ChatGPT (default: gpt-5.6-sol)
# GPT_MODEL=gpt-5.6-sol

# Required for /tk:ask-gemini (Gemini API calls)
GEMINI_API_KEY=

# Model version for Gemini (default: gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash

# Fallback mode: set to "1" to use concatenated prompts instead of systemInstruction
# Use this if you encounter issues with systemInstruction on your model/SDK version
# GEMINI_USE_CONCAT_PROMPT=1

# Optional: the design workflow's media generation (issue #160). Nothing here is
# required. When a key is absent, the toolkit hands you the prompt to run elsewhere.
# Image generation reuses OPENAI_API_KEY or GEMINI_API_KEY above.

# Video generation and video background matting go through fal.ai (an aggregator,
# so one key covers many models). Use a separate key with a tight spend limit.
FAL_KEY=

# Model ids change often on every provider. Override any of these when a provider
# answers 404 or 422 for the default.
# OPENAI_IMAGE_MODEL=gpt-image-1
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# FAL_VIDEO_MODEL=fal-ai/veo3
# FAL_MATTE_MODEL=fal-ai/ben/v2/video
