# Dependencies
node_modules/

# Environment (API keys: .env.local and any other .env*.local file)
.env*.local
.env

# Personal Claude Code permissions (machine paths, never shared)
.claude/settings.local.json

# OS
.DS_Store

# Debug logs
npm-debug.log*

# Editor
.idea/
.vscode/
*.swp

# Temporary files
/tmp/
/_tmp/

# Plan files (local working docs, stored in plans/)
plans/PLAN-*.md
plans/PLAN-*.html

# Research and review reports (local working docs, stored in reports/)
reports/

# IDE (local Cursor settings)
.cursor/

# Claude Code worktrees (Remote Control spawn mode)
.claude/worktrees/

# Codebase map (auto-generated by /tk:index, refreshed by /tk:document)
CODEBASE_MAP.md

# Toolkit backups (files /tk:setup preserved before a migration removed or changed them)
.toolkit-backup-*/

# Toolkit migration record (pairs with the backup folder above and holds local details).
# The state file .claude/.toolkit-state.json is shared and must stay committed.
.claude/.toolkit-migration.json

# HTML artifacts (cycle-bound HTML output generated by toolkit commands)
artifacts/html/

# Correction ledger. Belt-and-braces: the real files live under ~/.claude/, outside
# every repo, so git cannot commit them. These lines exist so a future decision to
# move the ledger into a repo cannot leak it silently. The toolkit's pre-push
# tripwire is the protection that does the work, and it also catches `git add -f`.
correction-ledger.jsonl
correction-heartbeat.jsonl
correction-rollup.json
correction-axial-map.json
correction-rows.json
