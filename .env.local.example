# Copy to .env.local and fill in your API key.
# Never commit .env.local.
# Quotes around values are optional - the parser handles both formats.
# Don't include 'export' - this is a .env file, not a shell script.

# Required for /ask-gpt command (ChatGPT API calls)
OPENAI_API_KEY=

# Model version for ChatGPT (default: gpt-5.6-sol)
# GPT_MODEL=gpt-5.6-sol

# Required for /ask-gemini command (Gemini API calls)
GEMINI_API_KEY=

# Model version for Gemini (default: gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash

# Fallback mode: set to "1" to use concatenated prompts instead of systemInstruction
# Use this if you encounter issues with systemInstruction on your model/SDK version
# GEMINI_USE_CONCAT_PROMPT=1

# Optional: the design workflow's media generation (issue #160). Nothing here is
# required. When a key is absent, gen-media.js hands you the prompt to run elsewhere.
# Image generation reuses OPENAI_API_KEY or GEMINI_API_KEY above.

# Video generation and video background matting go through fal.ai (an aggregator,
# so one key covers many models). Use a separate key with a tight spend limit.
FAL_KEY=

# Model ids change often on every provider. Override any of these when a provider
# answers 404 or 422 for the default.
# OPENAI_IMAGE_MODEL=gpt-image-1
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# FAL_VIDEO_MODEL=fal-ai/veo3
# FAL_MATTE_MODEL=fal-ai/ben/v2/video
